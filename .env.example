# Public Storefront token from Fourthwall (Developer → Storefront API).
# Never put the Platform / shop secret key here.
VITE_FOURTHWALL_STOREFRONT_TOKEN=ptkn_

# Optional. Host or full URL of the Fourthwall checkout.
# Falls back to the shop public domain from the API.
# VITE_FOURTHWALL_CHECKOUT=your-shop.fourthwall.com

# Optional. Starting currency for first-time visitors (default EUR).
# Visitors can switch currency on the site; their choice is remembered.
# VITE_FOURTHWALL_CURRENCY=EUR
